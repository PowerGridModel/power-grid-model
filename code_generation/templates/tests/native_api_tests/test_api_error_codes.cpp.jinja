        FAIL("throw_coded_error did not throw");
    } catch (PowerGridError const& error) {
        CHECK(typeid(error) == typeid(ExpectedError));
        CHECK(error.error_code() == expected_error_code);
        CHECK(std::string{error.what()} == "test message");
