{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power Grid Model experimental validation report",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "is_batch": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"is_batch": {"const": true}},
        "required": ["is_batch"]
      },
      "then": {
        "required": ["is_batch", "data"],
        "properties": {
          "is_batch": {"const": true},
          "data": {
            "type": "array",
            "items": {"$ref": "#/$defs/scenario"}
          }
        }
      },
      "else": {
        "required": ["issues"],
        "properties": {"issues": {"$ref": "#/$defs/issues"}}
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "scenario": {
      "type": "object",
      "properties": {
        "node": {"$ref": "#/$defs/issues"},
        "line": {"$ref": "#/$defs/issues"}
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "issue": {
      "oneOf": [
        {"$ref": "#/$defs/missingValue"},
        {"$ref": "#/$defs/infinity"},
        {"$ref": "#/$defs/notUnique"},
        {"$ref": "#/$defs/notGreaterThan"},
        {"$ref": "#/$defs/notBoolean"},
        {"$ref": "#/$defs/twoValuesZero"},
        {"$ref": "#/$defs/invalidIdReference"},
        {"$ref": "#/$defs/idNotInDataset"},
        {"$ref": "#/$defs/invalidUpdateId"},
        {"$ref": "#/$defs/crossComponentNotUnique"},
        {"$ref": "#/$defs/unknownIssue"}
      ]
    },
    "knownIssue": {
      "type": "object",
      "required": ["kind", "component", "field", "ids", "details"],
      "properties": {
        "kind": {"type": "string"},
        "component": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "ids": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/id"}
            }
          ]
        },
        "details": {"type": "object"},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/fieldReference"}
        },
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/objectReference"}
        },
        "reference_component": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      },
      "additionalProperties": true
    },
    "missingValue": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "missing_value"}
          }
        }
      ]
    },
    "infinity": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "infinity"}
          }
        }
      ]
    },
    "notUnique": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "not_unique"}
          }
        }
      ]
    },
    "notGreaterThan": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "not_greater_than"},
            "details": {
              "type": "object",
              "required": ["ref_value"],
              "properties": {"ref_value": {"$ref": "#/$defs/referenceValue"}},
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "notBoolean": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "not_boolean"}
          }
        }
      ]
    },
    "twoValuesZero": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "required": ["fields"],
          "properties": {
            "kind": {"const": "two_values_zero"},
            "fields": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/fieldReference"}
            }
          }
        }
      ]
    },
    "invalidIdReference": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "required": ["reference_component"],
          "properties": {
            "kind": {"const": "invalid_id_reference"},
            "reference_component": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "idNotInDataset": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "id_not_in_dataset"},
            "ids": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/id"}
            },
            "details": {
              "type": "object",
              "required": ["ref_dataset"],
              "properties": {"ref_dataset": {"const": "update"}},
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "invalidUpdateId": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "properties": {
            "kind": {"const": "invalid_update_id"},
            "field": {"const": "id"},
            "ids": {"type": "null"}
          }
        }
      ]
    },
    "crossComponentNotUnique": {
      "allOf": [
        {"$ref": "#/$defs/knownIssue"},
        {
          "required": ["fields", "objects"],
          "properties": {
            "kind": {"const": "cross_component_not_unique"},
            "ids": {"type": "null"},
            "fields": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/fieldReference"}
            },
            "objects": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/objectReference"}
            }
          }
        }
      ]
    },
    "unknownIssue": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "not": {
            "enum": [
              "missing_value",
              "infinity",
              "not_unique",
              "not_greater_than",
              "not_boolean",
              "two_values_zero",
              "invalid_id_reference",
              "id_not_in_dataset",
              "invalid_update_id",
              "cross_component_not_unique"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "id": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "fieldReference": {
      "type": "object",
      "required": ["component", "field"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "objectReference": {
      "type": "object",
      "required": ["component", "id"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": true
    },
    "taggedFloat": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "float"},
        "value": {"enum": ["nan", "positive_infinity", "negative_infinity"]}
      },
      "additionalProperties": false
    },
    "referenceScalar": {
      "oneOf": [
        {"type": "number"},
        {"type": "string"},
        {"$ref": "#/$defs/taggedFloat"}
      ]
    },
    "referenceValue": {
      "oneOf": [
        {"$ref": "#/$defs/referenceScalar"},
        {"type": "array", "items": {"$ref": "#/$defs/referenceScalar"}}
      ]
    }
  }
}