{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power Grid Model experimental validation report",
  "description": "Version 3 reports contain failures only. Unsupported components are ignored, and valid only covers components that were checked.",
  "type": "object",
  "required": ["schema_version", "validation_type", "valid", "results"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "validation_type": {
      "enum": ["input", "batch"]
    },
    "valid": {
      "type": "boolean",
      "description": "True when no failures were reported. Ignored components are not assessed. A zero-scenario batch does not validate the input."
    },
    "results": {
      "type": "array",
      "description": "Input reports contain zero results or one failed input scope. Batch reports contain only failed base/scenario scopes in base-then-scenario order; zero-scenario batches contain no scopes."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {"validation_type": {"const": "input"}},
        "required": ["validation_type"]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 0,
            "maxItems": 1,
            "items": {"$ref": "#/$defs/inputResult"}
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "oneOf": [
              {"maxItems": 0},
              {
                "minItems": 1,
                "prefixItems": [{"$ref": "#/$defs/inputResult"}],
                "items": {"$ref": "#/$defs/scenarioResult"}
              },
              {
                "minItems": 1,
                "items": {"$ref": "#/$defs/scenarioResult"}
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "required": ["scenario", "issues"],
      "properties": {
        "scenario": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "issues": {"$ref": "#/$defs/issues"}
      },
      "additionalProperties": true
    },
    "inputResult": {
      "description": "For batch reports, contains ID and value findings for the base input.",
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "scenario": {"type": "null"}
          }
        }
      ]
    },
    "scenarioResult": {
      "description": "Validates values on the base input merged with the scenario updates. Base value findings may repeat.",
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "scenario": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/issue"}
    },
    "issue": {
      "type": "object",
      "required": ["kind", "component", "field", "id", "row", "details"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/id"}
          ]
        },
        "row": {"type": "integer", "minimum": 0},
        "details": {"type": "object"}
      },
      "additionalProperties": true
    },
    "id": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    }
  }
}