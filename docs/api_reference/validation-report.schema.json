{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power Grid Model experimental validation report",
  "type": "object",
  "required": ["schema_version", "validation_type", "valid", "results"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "validation_type": {
      "enum": ["input", "batch"]
    },
    "valid": {"type": "boolean"},
    "results": {"type": "array"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {"validation_type": {"const": "input"}},
        "required": ["validation_type"]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1,
            "maxItems": 1,
            "items": {"$ref": "#/$defs/inputResult"}
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "oneOf": [
              {"maxItems": 0},
              {
                "minItems": 2,
                "prefixItems": [{"$ref": "#/$defs/inputResult"}],
                "items": {"$ref": "#/$defs/scenarioResult"}
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "required": ["scenario", "status", "issues"],
      "properties": {
        "scenario": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "status": {"enum": ["passed", "failed", "blocked"]},
        "issues": {"$ref": "#/$defs/issues"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "passed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"issues": {"maxItems": 0}}
          }
        }
      ],
      "additionalProperties": true
    },
    "inputResult": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "scenario": {"type": "null"},
            "status": {"enum": ["passed", "failed"]}
          }
        }
      ]
    },
    "scenarioResult": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "scenario": {"type": "integer", "minimum": 0},
            "status": {"enum": ["passed", "failed", "blocked"]}
          }
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "issue": {
      "type": "object",
      "required": ["kind", "fields", "objects", "details"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/fieldReference"}
        },
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/objectReference"}
        },
        "details": {"type": "object"}
      },
      "additionalProperties": true
    },
    "fieldReference": {
      "type": "object",
      "required": ["component", "field"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "objectReference": {
      "type": "object",
      "required": ["component", "id"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/id"}
          ]
        },
        "row": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "id": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    }
  }
}