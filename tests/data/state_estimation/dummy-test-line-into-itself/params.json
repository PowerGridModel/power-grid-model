{
  "calculation_method": [
    "newton_raphson"
  ],
  "rtol": 1e-09,
  "atol": {
    "default": 1e-09,
    "u_pu": 1e-06,
    "u": 0.01,
    "u_angle": 0.01,
    "p": 10.0,
    "q": 20.0,
    "p_from": 10.0,
    "q_from": 20.0,
    "p_to": 10.0,
    "q_to": 20.0,
    "i_from": 0.01,
    "i_to": 0.01,
    "s_from": 10.0,
    "s_to": 10.0,
    "i": 0.01,
    "s": 10.0,
    "pf": 1e-05,
    "p_residual": 10.0,
    "q_residual": 20.0,
    "u_residual": 0.01,
    "u_angle_residual": 1e-05
  },
  "xfail": {
    "raises": "AssertionError",
    "reason": "Energized behaves differently between sensors on disabled shunts and on disabled branches (https://github.com/PowerGridModel/power-grid-model/issues/1464)"
  }
