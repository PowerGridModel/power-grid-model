{
  "calculation_method": [
    "newton_raphson"
  ],
  "rtol": 1e-09,
  "atol": {
    "default": 1e-09,
    "u_pu": 1e-07,
    "u": 0.001,
    "u_angle": 0.001,
    "p": 0.003,
    "q": 0.01,
    "p_from": 0.003,
    "q_from": 0.01,
    "p_to": 0.003,
    "q_to": 0.01,
    "i_from": 1e-06,
    "i_to": 1e-06,
    "s_from": 0.004,
    "s_to": 0.004,
    "i": 1e-06,
    "s": 0.01,
    "pf": 1e-07,
    "p_residual": 0.002,
    "q_residual": 0.01,
    "u_residual": 0.001
  },
  "xfail": {
    "raises": "AssertionError",
    "reason": "Energized behaves differently between sensors on disabled shunts and on disabled branches (https://github.com/PowerGridModel/power-grid-model/issues/1464)"
  }
