{
  "calculation_method": ["iterative_linear", "newton_raphson"],
  "rtol": 1e-8,
  "atol": {
    "default": 1e-5,
    "p": 2e-2,
    "q": 2e-2,
    "s": 2e-2,
    "p_from": 2e-2,
    "q_from": 2e-2,
    "i_from": 1e-4,
    "s_from": 2e-2,
    "p_to": 2e-2,
    "q_to": 2e-2,
    "i_to": 1e-4,
    "s_to": 2e-2,
    "p_residual": 1e-2,
    "q_residual": 2e-2
  },
  "xfail": {
    "raises": "SparseMatrixError",
    "reason": "Bug in https://github.com/PowerGridModel/power-grid-model/issues/1567"
  }
}
